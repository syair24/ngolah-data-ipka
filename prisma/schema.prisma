generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DataPenimbangan {
  id              Int      @id @default(autoincrement())
  tanggal         String
  lebarMaterial   Decimal  @db.Decimal(10, 2)
  ukuran          String
  ketebalan       Decimal  @db.Decimal(10, 2)
  beratPiece      Decimal  @db.Decimal(10, 2)
  beratTabel      Decimal  @db.Decimal(10, 2)
  toleransi       Decimal  @db.Decimal(10, 2)
  warna           String
  dibuatPada      DateTime @default(now())
  diperbaruiPada  DateTime @updatedAt
}