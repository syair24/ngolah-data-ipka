generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int               @id @default(autoincrement())
  username        String            @unique
  email           String            @unique
  password        String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  dataPenimbangan DataPenimbangan[]
  notifications   Notification[]
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  aksi      String
  judul     String
  pesan     String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

model DataPenimbangan {
  id             Int      @id @default(autoincrement())
  tanggal        String
  lebarMaterial  Decimal  @db.Decimal(10, 2)
  ukuran         String
  ketebalan      Decimal  @db.Decimal(10, 2)
  beratPiece     Decimal  @db.Decimal(10, 2)
  beratTabel     Decimal  @db.Decimal(10, 2)
  toleransi      Decimal  @db.Decimal(10, 2)
  warna          String
  catatan        String?
  dibuatPada     DateTime @default(now())
  diperbaruiPada DateTime @updatedAt
  userId         Int
  batchId        String?
  user           User     @relation(fields: [userId], references: [id])
}
